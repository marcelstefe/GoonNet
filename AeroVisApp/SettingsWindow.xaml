<ui:FluentWindow x:Class="AeroVisApp.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 Title="Settings"
                 Width="860" Height="560"
                 MinWidth="600" MinHeight="400"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="pack://application:,,,/res/fonts/#Inter Variable">

    <ui:FluentWindow.Resources>
        <Style x:Key="SettingsNavStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppNavText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavPressed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActiveHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" Height="48"
                     ShowMinimize="False" ShowMaximize="False"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav panel -->
            <Border Grid.Row="0" Grid.Column="0" Padding="0,8,0,16">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,16,0,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNavStyle}"
                                 GroupName="SettingsNav" IsChecked="True" Checked="SettingsNavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox x:Name="SettingsNavGeneral" Source="/res/settings/settings.svg" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDevice" Style="{StaticResource SettingsNavStyle}"
                                 GroupName="SettingsNav" Checked="SettingsNavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox x:Name="SettingsNavDevice" Source="/res/settings/fan.svg" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Device" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavData" Style="{StaticResource SettingsNavStyle}"
                                 GroupName="SettingsNav" Checked="SettingsNavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox x:Name="SettingsNavData" Source="/res/settings/chart-line.svg" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Data" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource SettingsNavStyle}"
                                 GroupName="SettingsNav" Checked="SettingsNavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox x:Name="SettingsNavAbout" Source="/res/settings/info.svg" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Right white panel -->
            <Border Grid.Row="0" Grid.Column="1" Margin="12,8,12,8" Background="{DynamicResource AppCardBg}" CornerRadius="8">
                <Grid>

                <!-- General page -->
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="DISPLAY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#888" Margin="0,0,0,12"/>

                        <!-- Dark Mode -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dark Mode" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="Switch to dark theme" FontSize="11" Foreground="#999"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="DarkModeToggle" Grid.Column="1" VerticalAlignment="Center"
                                             Checked="DarkModeToggle_Changed" Unchecked="DarkModeToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="PageDevice" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="THROTTLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#888" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Throttle Sensitivity" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Input response scale" FontSize="11" Foreground="#999"/>
                                </StackPanel>
                                <ui:DropDownButton x:Name="ThrottleSensitivityDropDown" Grid.Column="1" Height="28" Padding="10,0"
                                                  CornerRadius="10" Content="5%"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  MouseOverBackground="{DynamicResource AppSubtleHover}"
                                                  MouseOverBorderBrush="Transparent">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem Header="1%" Click="ThrottleSensitivity_Click"/>
                                            <MenuItem Header="2%" Click="ThrottleSensitivity_Click"/>
                                            <MenuItem Header="5%" Click="ThrottleSensitivity_Click"/>
                                            <MenuItem Header="10%" Click="ThrottleSensitivity_Click"/>
                                            <MenuItem Header="25%" Click="ThrottleSensitivity_Click"/>
                                            <MenuItem Header="50%" Click="ThrottleSensitivity_Click"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>

                            <!-- FOGGER section -->
                            <TextBlock Text="FOGGER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#888" Margin="0,20,0,12"/>

                            <!-- Fogger Power -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fogger Power" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Output power level" FontSize="11" Foreground="#999"/>
                                </StackPanel>
                                <ui:DropDownButton x:Name="FoggerPowerDropDown" Grid.Column="1" Height="28" Padding="10,0"
                                                  CornerRadius="10" Content="50%"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  MouseOverBackground="{DynamicResource AppSubtleHover}"
                                                  MouseOverBorderBrush="Transparent">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu>
                                            <MenuItem Header="25%" Click="FoggerPower_Click"/>
                                            <MenuItem Header="50%" Click="FoggerPower_Click"/>
                                            <MenuItem Header="75%" Click="FoggerPower_Click"/>
                                            <MenuItem Header="100%" Click="FoggerPower_Click"/>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>

                            <!-- Fogger Liquid Amount -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fogger Liquid Amount" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Current fluid level" FontSize="11" Foreground="#999"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <svgc:SvgViewbox x:Name="DeviceDropletIcon" Source="/res/window/droplet.svg" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="120" Height="10" CornerRadius="5"
                                            Background="{DynamicResource AppProgressTrack}" ClipToBounds="True">
                                        <Border Background="#0067c0" CornerRadius="5"
                                                Width="78" HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBlock Text="65%" FontSize="11" Foreground="{DynamicResource AppSidebarValue}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Data page -->
                <ScrollViewer x:Name="PageData" VerticalScrollBarVisibility="Auto" Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <!-- HISTORY section -->
                        <TextBlock Text="HISTORY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#888" Margin="0,0,0,12"/>

                        <!-- Simulation History -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Simulation History" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="Manage saved simulation records" FontSize="11" Foreground="#999"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1.4"
                                    BorderBrush="#DC2626" CornerRadius="12" Padding="8,3"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonDown="BottomBar_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22DC2626"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Delete Simulation History" Foreground="#DC2626"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- About page -->
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="24,20"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ABOUT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#888" Margin="0,0,0,12"/>

                        <!-- App name & version -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AeroVis App" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="Version 1.0" FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </Grid>

                        <!-- Website -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Website" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="www.aerovis.org" FontSize="11" Foreground="#999"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1.4"
                                    BorderBrush="Gray" CornerRadius="12" Padding="8,3"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonUp="OpenWebsiteButton_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22000000"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Open in Web" Foreground="Gray"
                                           FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,4,14,12"
                  MouseLeftButtonDown="BottomBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SaveButton" BorderThickness="0"
                            CornerRadius="12" Padding="15,4" Margin="0,0,8,0" Cursor="Hand"
                            Background="#0067c0"
                            MouseLeftButtonUp="SaveButton_Click"
                            MouseEnter="SaveButton_MouseEnter"
                            MouseLeave="SaveButton_MouseLeave">
                        <TextBlock x:Name="SaveButtonText" Text="Save" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                    <Border BorderThickness="1.4" BorderBrush="Gray"
                            CornerRadius="12" Padding="15,4" Cursor="Hand"
                            MouseLeftButtonUp="CloseButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Close" Foreground="Gray" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

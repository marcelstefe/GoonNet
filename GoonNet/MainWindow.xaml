<ui:FluentWindow x:Class="GoonNet.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:dgprim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                 xmlns:local="clr-namespace:GoonNet"
                 mc:Ignorable="d"
                 Title="GoonNet Automation"
                 Background="Black"
                 Icon="pack://application:,,,/res/window/icon/GoonNet-Icon.ico"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 Height="720" Width="1280"
                 WindowStartupLocation="CenterScreen"
                 MinHeight="400" MinWidth="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.FontFamily>pack://application:,,,/fonts/#Inter-VariableFont_opsz,wght</ui:FluentWindow.FontFamily>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EventIconConverter x:Key="EventIcon"/>
        <local:EventColorConverter x:Key="EventColor"/>

        <!-- Full-line progress fill used as a player line's background -->
        <Style x:Key="PlayerLineProgress" TargetType="{x:Type ProgressBar}">
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#16a34a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One top-panel player line, bound to a PlayerSlot -->
        <DataTemplate x:Key="PlayerLineTemplate">
            <Grid>
                <!-- Progress through the current part (intro / main / outro), across the whole line;
                     it restarts at each part and turns red in the outro -->
                <ProgressBar x:Name="LineProgress" Style="{StaticResource PlayerLineProgress}"
                             Value="{Binding PartProgress, Mode=OneWay}"/>

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Event icon -->
                    <svgc:SvgViewbox Grid.Column="0"
                                     Source="{Binding EventName, Converter={StaticResource EventIcon}}"
                                     Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"
                                     RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Title + artist (the title trims first; the artist gets what's left) -->
                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" DockPanel.Dock="Left"
                                   Text="{Binding Title}"
                                   Foreground="{Binding EventName, Converter={StaticResource EventColor}}"
                                   FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Margin="8,0,0,0"
                                   Text="{Binding Artist}" Opacity="0.55"
                                   Foreground="{Binding EventName, Converter={StaticResource EventColor}}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Countdown for the current part, right-aligned -->
                    <TextBlock Grid.Column="2" Text="{Binding Countdown}"
                               Margin="14,0,0,0" MinWidth="54" VerticalAlignment="Center"
                               TextAlignment="Right"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Outro: the bar turns red -->
                <DataTrigger Binding="{Binding IsInOutro}" Value="True">
                    <Setter TargetName="LineProgress" Property="Foreground" Value="#dc2626"/>
                </DataTrigger>
                <!-- On air: title and artist go white so they read over the progress fill -->
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                    <Setter TargetName="ArtistText" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="{x:Type ui:TitleBarButton}"
               BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MouseOverBackground" Value="{DynamicResource AppNavBtnHover}"/>
            <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
            <Setter Property="PressedBackground" Value="{DynamicResource AppNavPressed}"/>
            <Setter Property="PressedBorderBrush" Value="Transparent"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="NavRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,10,10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover (unchecked) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavHover}"/>
                            </Trigger>
                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavPressed}"/>
                            </Trigger>
                            <!-- Active/checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </Trigger>
                            <!-- Hover while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActiveHover}"/>
                            </MultiTrigger>
                            <!-- Pressed while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="48">
            <ui:TitleBar.Header>
                <Image x:Name="AppBanner" Source="/res/window/GoonNet-Banner-White.png"
                       Height="28"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:Button Style="{StaticResource NavButtonStyle}" ToolTip="Settings"
                               Width="35" Height="35" Margin="0,0,4,0"
                               Click="SettingsButton_Click">
                        <svgc:SvgViewbox Source="/res/settings/settings.svg" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left nav panel -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Background="Transparent"
                    CornerRadius="0,12,12,0"
                    Margin="0,8,0,0"
                    Padding="0,8,0,26"
                    Width="60">
                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- L/R VU meter pinned to bottom (LED circles) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" HorizontalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Left channel (LEDs built in code: BuildVuMeter) -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel x:Name="VuLeftLeds" Orientation="Vertical" HorizontalAlignment="Center"/>
                            <TextBlock Text="L" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        <!-- Right channel (LEDs built in code: BuildVuMeter) -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel x:Name="VuRightLeds" Orientation="Vertical" HorizontalAlignment="Center"/>
                            <TextBlock Text="R" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        </StackPanel>
                        <svgc:SvgViewbox Source="/res/window/volume.svg" Width="20" Height="20"
                                         HorizontalAlignment="Center" Margin="0,20,0,0"
                                         RenderOptions.BitmapScalingMode="HighQuality"/>

                    </StackPanel>

                    <!-- Nav buttons at top -->
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">
                    <RadioButton x:Name="NavManualSimulation"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Studio"
                                 GroupName="Nav" IsChecked="True"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/play.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    <RadioButton x:Name="NavJingle"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Jingle"
                                 GroupName="Nav"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/jingle.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Test Panel -->
            <Grid x:Name="PageManualSimulation" Grid.Column="1" Grid.Row="0" Margin="12,0,12,0"
                  Visibility="{Binding IsChecked, ElementName=NavManualSimulation, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Height="275" Margin="0,0,0,6"
                        Background="{DynamicResource AppCardBg}" CornerRadius="8">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="Player0Host" Grid.Row="0"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource PlayerLineTemplate}"/>
                            <ContentControl x:Name="Player1Host" Grid.Row="2"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource PlayerLineTemplate}"/>
                            <ContentControl x:Name="Player2Host" Grid.Row="4"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource PlayerLineTemplate}"/>
                            <ContentControl x:Name="Player3Host" Grid.Row="6"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource PlayerLineTemplate}"/>
                        </Grid>

                        <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Width="72" x:Name="PlayNextButton" ToolTip="Play Next"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="PlayNextButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <svgc:SvgViewbox Source="/res/studio/skip-forward.svg" Width="20" Height="20"/>
                            </Button>

                            <Button Grid.Row="2" Width="72" x:Name="SecondaryActionButton" ToolTip="Fade Out"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="FadeOutButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <svgc:SvgViewbox x:Name="SecondaryActionIcon"
                                                 Source="/res/studio/square.svg" Width="20" Height="20"/>
                            </Button>

                            <Button Grid.Row="4" Width="72" x:Name="DlsButton" ToolTip="Dynamic Log Scheduling"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Content="DLS" FontSize="12"
                                    Click="DlsButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Row="6" Width="72" x:Name="ManualModeButton" ToolTip="Playout Mode"
                                    Background="#eab308" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Content="Manual" FontSize="12"
                                    Click="ManualModeButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Margin="0,6,6,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="ScheduleGrid" Background="Transparent" BorderThickness="0"
                                  PreviewMouseLeftButtonDown="ScheduleGrid_PreviewMouseLeftButtonDown"
                                  MouseMove="ScheduleGrid_MouseMove"
                                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  Foreground="White"
                                  GridLinesVisibility="None"
                                  RowHeight="24"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False"
                                  AllowDrop="True"
                                  DragOver="ScheduleGrid_DragOver"
                                  Drop="ScheduleGrid_Drop"
                                  BeginningEdit="ScheduleGrid_BeginningEdit"
                                  SelectionChanged="ScheduleGrid_SelectionChanged"
                                  Margin="8">
                            <DataGrid.Resources>
                                <!-- Insert hint offset; kept on the Title column by UpdateInsertHintLayout. -->
                                <Thickness x:Key="InsertHintMargin">228,0,0,0</Thickness>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="dgprim:DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Event, Converter={StaticResource EventColor}}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <!-- Row details (the insert hint) are hidden here and shown only by the
                                         ShowInsertHint trigger below. Don't set RowDetailsVisibilityMode on the
                                         grid: a value set there takes priority over this style and hides them all. -->
                                    <Setter Property="DetailsVisibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                        </Trigger>
                                        <!-- Fixed rows (hour markers): no hover highlight -->
                                        <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <!-- Empty hour: show the insert hint line under the marker -->
                                        <DataTrigger Binding="{Binding ShowInsertHint}" Value="True">
                                            <Setter Property="DetailsVisibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- Playing (on air or playing out): white text, as in the top players -->
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <!-- Under an empty hour marker: arrow and text in the Title column, lined up with the titles.
                                 Dropping a track here puts it into that hour. -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Height="24"
                                                Margin="{DynamicResource InsertHintMargin}">
                                        <svgc:SvgViewbox Source="/res/studio/corner-down-right.svg"
                                                         Width="14" Height="14" VerticalAlignment="Center"
                                                         RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Insert Tracks Here..." Margin="6,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#808080"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#454545"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Air Time" Binding="{Binding AirTime, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                                <DataGridTemplateColumn Header="Event" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <svgc:SvgViewbox Width="15" Height="15"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             ToolTip="{Binding Event}"
                                                             RenderOptions.BitmapScalingMode="HighQuality">
                                                <svgc:SvgViewbox.Style>
                                                    <Style TargetType="svgc:SvgViewbox">
                                                        <Setter Property="Source" Value="{Binding Event, Converter={StaticResource EventIcon}}"/>
                                                        <Style.Triggers>
                                                            <!-- Hour markers ("Hour Playlist") get the clock -->
                                                            <DataTrigger Binding="{Binding IsHourMarker}" Value="True">
                                                                <Setter Property="Source" Value="pack://application:,,,/res/events/clock.svg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </svgc:SvgViewbox.Style>
                                            </svgc:SvgViewbox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ScheduleTitleColumn" Header="Title" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" Opacity="0.55"
                                                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Intro" Binding="{Binding Intro}" Width="80"/>
                                <DataGridTextColumn Header="Outro" Binding="{Binding Outro}" Width="80"/>
                                <DataGridTextColumn Header="Hook" Binding="{Binding Hook}" Width="80"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVis}}">
                                                <Button Width="20" Height="20" Margin="0,0,2,0" ToolTip="Mix with next item"
                                                        Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Cursor="Hand" Click="PlaylistEditButton_Click">
                                                    <svgc:SvgViewbox Source="/res/studio/audio-lines.svg" Width="12" Height="12"/>
                                                </Button>
                                                <Button Width="20" Height="20" ToolTip="Remove"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Cursor="Hand" Click="PlaylistRemoveButton_Click"
                                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                                    <svgc:SvgViewbox Source="/res/studio/trash.svg" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="6,6,0,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Import File"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            Click="ImportFileButton_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/plus.svg" Width="20" Height="20"/>
                                    </Button>
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Mass Import Files"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            Click="MassImportButton_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/folder-down.svg" Width="20" Height="20"/>
                                    </Button>
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Refresh"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/refresh-ccw.svg" Width="20" Height="20"/>
                                    </Button>
                                    </StackPanel>
                                <ComboBox x:Name="LibraryTypeFilter" Height="40" VerticalAlignment="Center"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="LibraryTypeFilter_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Song"/>
                                    <ComboBoxItem Content="Station ID"/>
                                    <ComboBoxItem Content="Promo"/>
                                    <ComboBoxItem Content="Commercial"/>
                                    <ComboBoxItem Content="News"/>
                                    <ComboBoxItem Content="Bed"/>
                                    <ComboBoxItem Content="Voice Track"/>
                                    <ComboBoxItem Content="Command"/>
                                </ComboBox>
                            </DockPanel>

                            <ui:TextBox Grid.Row="2" x:Name="LibrarySearchBox" Height="40" VerticalAlignment="Center"
                                        PlaceholderText="Search..."
                                        TextChanged="LibrarySearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="6,6,0,8"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="LibraryGrid" Background="Transparent" BorderThickness="0"
                                  BeginningEdit="LibraryGrid_BeginningEdit"
                                  PreviewMouseLeftButtonDown="LibraryGrid_PreviewMouseLeftButtonDown"
                                  MouseMove="LibraryGrid_MouseMove"
                                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  Foreground="White"
                                  GridLinesVisibility="None"
                                  RowHeight="24"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False"
                                  Margin="8">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="dgprim:DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Event, Converter={StaticResource EventColor}}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#454545"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                                <DataGridTemplateColumn Header="Event" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <svgc:SvgViewbox Source="{Binding Event, Converter={StaticResource EventIcon}}"
                                                             Width="15" Height="15"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             ToolTip="{Binding Event}"
                                                             RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Title" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" Opacity="0.55"
                                                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Intro" Binding="{Binding Intro}" Width="80"/>
                                <DataGridTextColumn Header="Outro" Binding="{Binding Outro}" Width="80"/>
                                <DataGridTextColumn Header="Hook" Binding="{Binding Hook}" Width="80"/>
                                <DataGridTemplateColumn Header="" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVis}}">
                                                <Button Width="20" Height="20" Margin="0,0,2,0" ToolTip="Edit"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Cursor="Hand" Click="EditTrackButton_Click"
                                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                                    <svgc:SvgViewbox Source="/res/studio/edit.svg" Width="12" Height="12"/>
                                                </Button>
                                                <Button Width="20" Height="20" ToolTip="Remove"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Cursor="Hand" Click="RemoveTrackButton_Click"
                                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                                    <svgc:SvgViewbox Source="/res/studio/trash.svg" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
            <!-- Bottom bar spanning content area -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="12,6,14,13">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveTime"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LiveDate"
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="12" Padding="8,3">
                    <TextBlock Text="Pre-Release"
                               Foreground="Gray"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>



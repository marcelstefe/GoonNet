<ui:FluentWindow x:Class="GoonNet.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:dgprim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                 xmlns:local="clr-namespace:GoonNet"
                 mc:Ignorable="d"
                 Title="GoonNet Automation"
                 Background="Black"
                 Icon="pack://application:,,,/res/window/icon/GoonNet-Icon.ico"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 Height="720" Width="1280"
                 WindowStartupLocation="CenterScreen"
                 MinHeight="400" MinWidth="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.FontFamily>pack://application:,,,/fonts/#Inter-VariableFont_opsz,wght</ui:FluentWindow.FontFamily>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="{x:Type ui:TitleBarButton}"
               BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MouseOverBackground" Value="{DynamicResource AppNavBtnHover}"/>
            <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
            <Setter Property="PressedBackground" Value="{DynamicResource AppNavPressed}"/>
            <Setter Property="PressedBorderBrush" Value="Transparent"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="NavRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,10,10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover (unchecked) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavHover}"/>
                            </Trigger>
                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavPressed}"/>
                            </Trigger>
                            <!-- Active/checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </Trigger>
                            <!-- Hover while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActiveHover}"/>
                            </MultiTrigger>
                            <!-- Pressed while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="48">
            <ui:TitleBar.Header>
                <Image x:Name="AppBanner" Source="/res/window/GoonNet-Banner-White.png"
                       Height="28"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:Button Style="{StaticResource NavButtonStyle}" ToolTip="Settings"
                               Width="35" Height="35" Margin="0,0,4,0"
                               Click="SettingsButton_Click">
                        <svgc:SvgViewbox Source="/res/settings/settings.svg" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left nav panel -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Background="Transparent"
                    CornerRadius="0,12,12,0"
                    Margin="0,8,0,0"
                    Padding="0,8,0,26"
                    Width="60">
                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- L/R VU meter pinned to bottom (LED circles) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" HorizontalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Left channel -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#ef4444" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#ef4444" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="L" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        <!-- Right channel -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="R" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        </StackPanel>
                        <svgc:SvgViewbox Source="/res/window/volume.svg" Width="20" Height="20"
                                         HorizontalAlignment="Center" Margin="0,20,0,0"
                                         RenderOptions.BitmapScalingMode="HighQuality"/>

                    </StackPanel>

                    <!-- Nav buttons at top -->
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">
                    <RadioButton x:Name="NavManualSimulation"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Studio"
                                 GroupName="Nav" IsChecked="True"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/play.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    <RadioButton x:Name="NavJingle"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Jingle"
                                 GroupName="Nav"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/jingle.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Test Panel -->
            <Grid x:Name="PageManualSimulation" Grid.Column="1" Grid.Row="0" Margin="12,0,12,0"
                  Visibility="{Binding IsChecked, ElementName=NavManualSimulation, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Height="275" Margin="0,0,0,6"
                        Background="{DynamicResource AppCardBg}" CornerRadius="8">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="Black" CornerRadius="8"/>
                            <Border Grid.Row="2" Background="Black" CornerRadius="8"/>
                            <Border Grid.Row="4" Background="Black" CornerRadius="8"/>
                            <Border Grid.Row="6" Background="Black" CornerRadius="8"/>
                        </Grid>

                        <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Width="72" ToolTip="Play Next"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <svgc:SvgViewbox Source="/res/studio/skip-forward.svg" Width="20" Height="20"/>
                            </Button>

                            <Button Grid.Row="2" Width="72" x:Name="SecondaryActionButton" ToolTip="Fade Out"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <svgc:SvgViewbox x:Name="SecondaryActionIcon"
                                                 Source="/res/studio/square.svg" Width="20" Height="20"/>
                            </Button>

                            <Button Grid.Row="4" Width="72" x:Name="DlsButton" ToolTip="Dynamic Log Scheduling"
                                    Background="Black" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Content="DLS" FontSize="12"
                                    Click="DlsButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Row="6" Width="72" x:Name="ManualModeButton" ToolTip="Playout Mode"
                                    Background="#eab308" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Content="Manual" FontSize="12"
                                    Click="ManualModeButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Margin="0,6,6,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8" ClipToBounds="True">
                        <DataGrid Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  Foreground="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#22FFFFFF"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False"
                                  Margin="8">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="dgprim:DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Air Time" Binding="{Binding Time}" Width="80"/>
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="80"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Intro" Binding="{Binding Intro}" Width="80"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="6,6,0,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Import File"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/plus.svg" Width="20" Height="20"/>
                                    </Button>
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Mass Import Files"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/folder-down.svg" Width="20" Height="20"/>
                                    </Button>
                                    <Button Width="40" Height="40" Margin="0,0,8,0" ToolTip="Refresh"
                                            Background="Black" Foreground="White"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <svgc:SvgViewbox Source="/res/library/refresh-ccw.svg" Width="20" Height="20"/>
                                    </Button>
                                    </StackPanel>
                                <ui:TextBox Height="40" VerticalAlignment="Center" PlaceholderText="Search..."/>
                            </DockPanel>

                            <UniformGrid Grid.Row="2" Rows="1" Columns="7">
                                <Button Content="All" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Music" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Jingles" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Spots" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Blocks" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="VTs" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Commands" Height="40" Margin="4,0" Background="Black" Foreground="White"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="6,6,0,8"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8" ClipToBounds="True">
                        <DataGrid Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  Foreground="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#22FFFFFF"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False"
                                  Margin="8">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="dgprim:DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="80"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Intro" Binding="{Binding Intro}" Width="80"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
            <!-- Bottom bar spanning content area -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="12,6,14,13">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveTime"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LiveDate"
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="12" Padding="8,3">
                    <TextBlock Text="Pre-Release"
                               Foreground="Gray"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>



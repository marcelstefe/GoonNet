<ui:FluentWindow x:Class="GoonNet.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:local="clr-namespace:GoonNet"
                 mc:Ignorable="d"
                 Title="GoonNet"
                 Background="Black"
                 Icon="pack://application:,,,/res/window/icon/GoonNet-Icon.ico"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 Height="720" Width="1280"
                 WindowStartupLocation="CenterScreen"
                 MinHeight="400" MinWidth="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.FontFamily>pack://application:,,,/fonts/#Inter-VariableFont_opsz,wght</ui:FluentWindow.FontFamily>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="{x:Type ui:TitleBarButton}"
               BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MouseOverBackground" Value="{DynamicResource AppNavBtnHover}"/>
            <Setter Property="MouseOverBorderBrush" Value="Transparent"/>
            <Setter Property="PressedBackground" Value="{DynamicResource AppNavPressed}"/>
            <Setter Property="PressedBorderBrush" Value="Transparent"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="NavRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,10,10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover (unchecked) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavHover}"/>
                            </Trigger>
                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavPressed}"/>
                            </Trigger>
                            <!-- Active/checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </Trigger>
                            <!-- Hover while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActiveHover}"/>
                            </MultiTrigger>
                            <!-- Pressed while checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="48">
            <ui:TitleBar.Header>
                <Image x:Name="AppBanner" Source="/res/window/GoonNet-Banner-White.png"
                       Height="28"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:Button Style="{StaticResource NavButtonStyle}" ToolTip="Settings"
                               Width="35" Height="35" Margin="0,0,4,0"
                               Click="SettingsButton_Click">
                        <svgc:SvgViewbox Source="/res/settings/settings.svg" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left nav panel -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Background="Transparent"
                    CornerRadius="0,12,12,0"
                    Margin="0,8,0,0"
                    Padding="0,8,0,26"
                    Width="60">
                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- L/R VU meter pinned to bottom (LED circles) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" HorizontalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Left channel -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#ef4444" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#ef4444" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="L" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        <!-- Right channel -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AppCardBg}" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#eab308" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>
                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,3"/>                                <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="R" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppSidebarValue}"/>
                        </StackPanel>

                        </StackPanel>
                        <svgc:SvgViewbox Source="/res/window/volume.svg" Width="20" Height="20"
                                         HorizontalAlignment="Center" Margin="0,20,0,0"
                                         RenderOptions.BitmapScalingMode="HighQuality"/>

                    </StackPanel>

                    <!-- Nav buttons at top -->
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">
                    <RadioButton x:Name="NavManualSimulation"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Studio"
                                 GroupName="Nav" IsChecked="True"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/play.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    <RadioButton x:Name="NavLibrary"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Library"
                                 GroupName="Nav"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/library.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    <RadioButton x:Name="NavJingle"
                                 Style="{StaticResource NavRadioButtonStyle}" Width="60" ToolTip="Jingle"
                                 GroupName="Nav"
                                 Checked="NavButton_Checked">
                        <svgc:SvgViewbox Source="/res/window/jingle.svg" Width="20" Height="20" Margin="10,0,0,0"/>
                    </RadioButton>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Test Panel -->
            <Grid x:Name="PageManualSimulation" Grid.Column="1" Grid.Row="0" Margin="12,0,12,0"
                  Visibility="{Binding IsChecked, ElementName=NavManualSimulation, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Height="250" Margin="0,0,0,6"
                        Background="{DynamicResource AppCardBg}" CornerRadius="8">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Black" CornerRadius="8"/>
                        <Border Grid.Row="2" Background="Black" CornerRadius="8"/>
                        <Border Grid.Row="4" Background="Black" CornerRadius="8"/>
                        <Border Grid.Row="6" Background="Black" CornerRadius="8"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,6,6,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8"/>
                    <Border Grid.Row="1" Height="100" Margin="0,6,6,8"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="100" Margin="6,6,0,6"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8"/>
                    <Border Grid.Row="1" Margin="6,6,0,8"
                            Background="{DynamicResource AppCardBg}" CornerRadius="8"/>
                </Grid>
            </Grid>
            <!-- Bottom bar spanning content area -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="12,6,14,13">
                <!-- Live date/time on the left -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveDate"
                               Foreground="Gray"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="15" Background="Gray" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveTime"
                               Foreground="Gray"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="1.4" BorderBrush="Gray"
                        CornerRadius="12" Padding="8,3">
                    <TextBlock Text="Player Offline"
                               Foreground="Gray"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>




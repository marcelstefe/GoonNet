<ui:FluentWindow x:Class="GoonNet.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 Title="Settings"
                 Width="860" Height="560"
                 MinWidth="600" MinHeight="400"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="pack://application:,,,/res/fonts/#Inter Variable">

    <ui:FluentWindow.Resources>
        <Style x:Key="SettingsNavStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppNavText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavPressed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActive}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppNavActiveHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" Height="48"
                     ShowMinimize="False" ShowMaximize="False"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav panel -->
            <Border Grid.Row="0" Grid.Column="0" Padding="0,8,0,16">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,16,0,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNavStyle}"
                                 GroupName="SettingsNav" IsChecked="True" Checked="SettingsNavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox x:Name="SettingsNavGeneral" Source="/res/settings/settings.svg" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Right white panel -->
            <Border Grid.Row="0" Grid.Column="1" Margin="12,8,12,8" Background="{DynamicResource AppCardBg}" CornerRadius="8">
                <Grid>

                <!-- General page -->
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel/>
                </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,4,14,12"
                  MouseLeftButtonDown="BottomBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SaveButton" BorderThickness="0"
                            CornerRadius="12" Padding="15,4" Margin="0,0,8,0" Cursor="Hand"
                            Background="#0067c0"
                            MouseLeftButtonUp="SaveButton_Click"
                            MouseEnter="SaveButton_MouseEnter"
                            MouseLeave="SaveButton_MouseLeave">
                        <TextBlock x:Name="SaveButtonText" Text="Save" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                    <Border BorderThickness="1.4" BorderBrush="Gray"
                            CornerRadius="12" Padding="15,4" Cursor="Hand"
                            MouseLeftButtonUp="CloseButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Close" Foreground="Gray" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

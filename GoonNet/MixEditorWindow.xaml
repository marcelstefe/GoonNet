<ui:FluentWindow x:Class="GoonNet.MixEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:local="clr-namespace:GoonNet"
                 Title="Mix Editor"
                 Width="1500" Height="750"
                 MinWidth="640" MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="pack://application:,,,/res/fonts/#Inter Variable">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Mix Editor" Height="48" ShowMinimize="False"/>

        <Border Grid.Row="1" Margin="12,8,12,8"
                Background="{DynamicResource AppCardBg}" CornerRadius="8">
            <Border Margin="24,20" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8"
                    Background="#0f0f0f" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Mix timeline -->
                    <Border Grid.Row="0" Background="#0a0a0a" CornerRadius="6"
                            BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <local:MixTimeline x:Name="MixView"/>
                            <TextBlock x:Name="LoadingText" Text="Loading waveforms…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" FontSize="13" Foreground="Gray"/>
                        </Grid>
                    </Border>

                    <!-- Transport bar under the timeline -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="PlayPauseButton" Width="36" Height="36" Margin="0,0,6,0"
                                Background="Black" Foreground="White" IsEnabled="False"
                                BorderThickness="0" Cursor="Hand" ToolTip="Preview the mix (play/pause)"
                                Click="PlayPauseButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <svgc:SvgViewbox x:Name="PlayPauseIcon" Source="/res/window/play.svg" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="StopButton" Width="36" Height="36" Margin="0,0,12,0"
                                Background="Black" Foreground="White" IsEnabled="False"
                                BorderThickness="0" Cursor="Hand" ToolTip="Stop"
                                Click="StopButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                            <svgc:SvgViewbox Source="/res/studio/arrow-left-to-line.svg" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="ResetButton" Content="Reset" Height="36" Padding="12,0"
                                Background="Black" Foreground="White" IsEnabled="False"
                                BorderThickness="0" Cursor="Hand" FontSize="12"
                                ToolTip="Move the mix point back and clear the volume lines"
                                Click="ResetButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="2" Margin="12,4,14,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border BorderThickness="0"
                        CornerRadius="12" Padding="15,4" Margin="0,0,8,0" Cursor="Hand"
                        Style="{StaticResource AppPrimaryPillStyle}"
                        MouseLeftButtonUp="SaveButton_Click">
                    <TextBlock Text="Save" Foreground="White" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
                <Border BorderThickness="1.4" BorderBrush="Gray"
                        CornerRadius="12" Padding="15,4" Cursor="Hand"
                        Style="{StaticResource AppSecondaryPillStyle}"
                        MouseLeftButtonUp="CancelButton_Click">
                    <TextBlock Text="Cancel" Foreground="Gray" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

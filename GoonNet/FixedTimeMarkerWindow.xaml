<ui:FluentWindow x:Class="GoonNet.FixedTimeMarkerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Fixed Time Marker"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="pack://application:,,,/res/fonts/#Inter Variable">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Fixed Time Marker" Height="48"
                     ShowMinimize="False" ShowMaximize="False"/>

        <Border Grid.Row="1" Margin="12,8,12,8"
                Background="{DynamicResource AppCardBg}" CornerRadius="8">
            <StackPanel Margin="24,20" Orientation="Vertical">
                <TextBlock x:Name="HourLabel" Text="Time within the hour (mm:ss)" FontSize="13" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="TimeBox" Height="36" Margin="0,0,0,16" PlaceholderText="mm:ss"/>

                <TextBlock Text="Type" FontSize="13" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModeBox" Height="36" Style="{StaticResource AppComboBoxStyle}">
                    <ComboBoxItem Content="Hard"/>
                    <ComboBoxItem Content="Soft"/>
                    <ComboBoxItem Content="Not Before"/>
                </ComboBox>
                <TextBlock x:Name="ModeDescription" Margin="0,8,0,0" FontSize="12"
                           Foreground="Gray" TextWrapping="Wrap"/>

                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="12"
                           Foreground="#ef4444" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,4,14,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border BorderThickness="0"
                        CornerRadius="12" Padding="15,4" Margin="0,0,8,0" Cursor="Hand"
                        Style="{StaticResource AppPrimaryPillStyle}"
                        MouseLeftButtonUp="InsertButton_Click">
                    <TextBlock Text="Insert" Foreground="White" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
                <Border BorderThickness="1.4" BorderBrush="Gray"
                        CornerRadius="12" Padding="15,4" Cursor="Hand"
                        Style="{StaticResource AppSecondaryPillStyle}"
                        MouseLeftButtonUp="CancelButton_Click">
                    <TextBlock Text="Cancel" Foreground="Gray" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
